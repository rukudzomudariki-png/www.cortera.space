{
  "name": "cortera",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:no-forms && npm run check:claims && npm run check:env && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:no-forms": "node scripts/check-no-forms.js",
    "check:claims": "node scripts/check-claims.js",
    "check:env": "node scripts/check-env.js",
    "check:seo": "node scripts/check-seo.js",
    "verify:deploy": "npm run lint && npm run typecheck && npm run test && npm run check:no-forms && npm run check:claims && npm run check:env && npm run build && node scripts/verify-runtime.js"
  },
  "dependencies": {
    "framer-motion": "14.6.0",
    "gray-matter": "4.0.3",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "next-mdx-remote": "6.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rehype-pretty-code": "0.14.5",
    "remark-gfm": "4.0.1",
    "shiki": "4.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4",
    "@types/node": "20",
    "@types/react": "19",
    "@types/react-dom": "19",
    "eslint": "9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4",
    "typescript": "5",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
